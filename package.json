{
  "name": "dsh-codex-setting-ui",
  "version": "0.1.0",
  "description": "独立的 Codex 风格设置布局：分类导航、分类搜索和响应式布局，复用 Harness 原有设置窗口与保存接口。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json"},
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {"build": "node scripts/build.mjs", "test": "node --test test/*.test.mjs", "check": "node scripts/build.mjs && node --check lib/client.js && node --test test/*.test.mjs"},
  "dsh": {
    "engines": {"dsh": ">=0.2.1-rc.2"},
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "inject": []}
  }
}
