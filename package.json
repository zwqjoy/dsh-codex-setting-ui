{
  "name": "dsh-codex-setting-ui",
  "version": "0.2.0",
  "description": "独立的 Codex 风格设置布局，附带默认关闭的实验性用户消息编辑重发。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/build.mjs && node --check lib/client.js && node --test test/*.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright": "1.58.2"
  }
}
